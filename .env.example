# Copy to .env and set your credential there. Never commit .env.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=64
LLM_SEED=42
LLM_MAX_TOKENS_FIELD=max_completion_tokens
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1
LLM_MAX_BACKOFF_SECONDS=8
LLM_REQUESTS_PER_MINUTE=8
# Optional current provider prices; leave empty if unknown. No prices are hardcoded.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# OpenAI-compatible provider: set LLM_PROVIDER=openai_compatible, model/base URL,
# and any supported seed/token-cap field. Use LLM_SEED=none if unsupported.
# Anthropic: set LLM_PROVIDER=anthropic, an actual Claude model name,
# LLM_BASE_URL=https://api.anthropic.com/v1, LLM_SEED=none.
# For models that disallow temperature, set LLM_TEMPERATURE=none for ALL conditions.
